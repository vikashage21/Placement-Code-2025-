<% layout('layouts/boilerplate') -%>

<div class="card shadow-sm rounded-4 p-4 mx-auto" style="max-width: 700px;">
  <h2 class="text-center fw-bold mb-4">Edit Post</h2>
  <form action="/listing/<%= list.id %>/edit?_method=PUT" method="post">
    <div class="mb-3">
      <label class="form-label fw-semibold">Title</label>
      <input type="text" name="title" class="form-control" placeholder="Enter title" value="<%= list.title %>" required>
    </div>
    <div class="mb-3">
      <label class="form-label fw-semibold">Description</label>
      <textarea name="description" class="form-control" rows="5" placeholder="Enter description" required><%= list.description %></textarea>
    </div>
    <div class="mb-3">
      <label class="form-label fw-semibold">Image URL</label>
      <input type="text" name="image" class="form-control" placeholder="Enter image URL" value="<%= list.image %>">
    </div>
    <div class="row g-3">
      <div class="col-md-4">
        <label class="form-label fw-semibold">Price</label>
        <input type="text" name="price" class="form-control" placeholder="Enter price" value="<%= list.price %>">
      </div>
      <div class="col-md-5">
        <label class="form-label fw-semibold">Location</label>
        <input type="text" name="location" class="form-control" placeholder="Enter location" value="<%= list.location %>">
      </div>
      <div class="col-md-3">
        <label class="form-label fw-semibold">Country</label>
        <input type="text" name="country" class="form-control" placeholder="Enter country" value="<%= list.country %>">
      </div>
    </div>
    <div class="d-flex gap-2 mt-4">
      <button type="submit" class="btn btn-primary flex-fill">Update Post</button>
      <a href="/listing/<%= list.id %>" class="btn btn-secondary flex-fill">Cancel</a>
    </div>
  </form>
</div>
