<% layout('layouts/boilerplate') -%>
    <style>
        .card {
            transition: all 0.3s ease !important;
        }

        .card:hover {
            transform: translateY(-5px) !important;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15) !important;
        }

        .custom-range::-webkit-slider-thumb {
            background-color: #ffc107;
            /* gold color */
            border: 2px solid #fff;
            box-shadow: 0 0 4px rgba(0, 0, 0, 0.2);
        }

        .custom-range::-webkit-slider-thumb:hover {
            transform: scale(1.1);
        }

        .custom-range::-webkit-slider-runnable-track {
            background: linear-gradient(to right, #ffc107, #ffe082);
        }
    </style>

    <div class="container  my-4">
        <div class="card w-50 mx-auto h-100">
            <% if (list.image) { %>
                <img style="object-fit: cover" src="<%= list.image %>" class="card-img-top w-100 h-100"
                    alt="<%= list.title %>">
                <% } else { %>
                    <img src="https://via.placeholder.com/600x300?text=No+Image" class="card-img-top" alt="No Image">
                    <% } %>
                        <div class="card-body">
                            <h3 class="card-title">
                                <%= list.title %>
                            </h3>
                            <p class="card-text"><strong>Description:</strong>
                                <%= list.description %>
                            </p>
                            <p class="card-text"><strong>Price:</strong> ₹<%= list.price %>
                            </p>
                            <p class="card-text"><strong>Location:</strong>
                                <%= list.location %>
                            </p>
                            <p class="card-text"><strong>Country:</strong>
                                <%= list.country %>
                            </p>

                            <a href="/listing/<%= list.id %>/edit" class="btn btn-warning me-2">Edit</a>

                            <form action="/listing/<%= list.id %>/edit?_method=DELETE" method="post" class="d-inline">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </div>
        </div>
        <div class="d-flex flex-column">
            <div class="col-8 offset-3">

                <h2>leave reviews</h2>
                <form action="/listing/<%= list.id%>/review" method="post" novalidate class="needs-validation">
                    <div>
                        <label for="rating" class="form-label fw-semibold text-secondary">
                            Rating <span id="ratingValue" class="text-warning fw-bold ms-2">3 ⭐</span>
                        </label>

                        <input type="range" min="1" max="5" value="3" id="rating" name="review[rating]"
                            class="form-range custom-range">

                        <div class="d-flex justify-content-between text-muted small mt-1">
                            <span>1 ⭐</span>
                            <span>2 ⭐</span>
                            <span>3 ⭐</span>
                            <span>4 ⭐</span>
                            <span>5 ⭐</span>
                        </div>
                    </div>

                    <textarea name="review[comment]" id="comment" cols="10" rows="5" class="form-control"
                        required></textarea>
                    <button class="btn btn-primary mt-2"> submit </button>
            </div>
            </form>
        </div>
    </div>

    <hr>
    <h1 class="text-center my-4 fw-bold text-primary">All Reviews</h1>

    <div class="container">
        <div class="row g-4">
            <% list.reviews.forEach(element=> { %>
                <div class="col-md-4 col-sm-6">
                    <div class="card shadow-lg border-0 rounded-4 h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title text-capitalize mb-0 text-secondary">
                                    <i class="bi bi-person-circle me-1"></i> Reviewer
                                </h5>
                                <span class="badge bg-warning text-dark">
                                    ⭐ <%= element.rating %> / 5
                                </span>
                            </div>
                            <p class="card-text text-muted mt-2">
                                "<%= element.comment %>"
                            </p>
                        </div>
                        <div class="card-footer bg-light text-end border-0">
                            <small class="text-muted">— Thank you for your feedback!</small>
                        </div>
                        <form action="/listing/<%=list.id%>/review/<%= element.id  %>?_method=DELETE" method="post" class="m-2">
                            <button class="btn btn-outline-danger">delete</button>
                        </form>
                    </div>
                </div>
                <% }) %>
        </div>
    </div>


    </div>

    <script>
        const ratingInput = document.getElementById('rating');
        const ratingValue = document.getElementById('ratingValue');

        ratingInput.addEventListener('input', function () {
            ratingValue.textContent = `${this.value} ⭐`;
        });
    </script>
    <script src="/script.js"></script>