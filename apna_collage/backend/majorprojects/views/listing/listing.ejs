<% layout('layouts/boilerplate') -%>

<!-- Leaflet CSS -->
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>


  <!-- Listing Card -->
  <div class="card shadow-sm rounded-4 mb-4 overflow-hidden">
    <div style="height: 350px; overflow:hidden;">
      <% if (list.image) { %>
        <img src="<%= list.image.url%>" class="card-img-top w-100 h-100" style="object-fit: cover;"
          alt="<%= list.title %>">
        <% } else { %>
          <img src="https://via.placeholder.com/600x350?text=No+Image" class="card-img-top" alt="No Image">
          <% } %>
    </div>

    <div class="card-body">
      <p class="mb-3"><b>@<%= list.owner ? list.owner.username : "Unknown" %></b></p>
      <h2 class="fw-bold mb-3">
        <%= list.title %>
      </h2>
      <p class="text-secondary mb-1"><strong>Price:</strong> ₹<%= list.price %>
      </p>
      <p class="text-secondary mb-1"><strong>Location:</strong>
        <%= list.location %>
      </p>
      <p class="text-secondary mb-1"><strong>Country:</strong>
        <%= list.country %>
      </p>
      <p class="mb-3">
        <%= list.description %>
      </p>

      <% if (currentUser && list.owner && currentUser._id.equals(list.owner._id)) { %>
        <div class="d-flex gap-2 mb-3">
          <a href="/listing/<%= list.id %>/edit" class="btn btn-outline-warning flex-fill">Edit</a>
          <form action="/listing/<%= list.id %>/edit?_method=DELETE" method="POST" class="flex-fill">
            <button type="submit" class="btn btn-outline-danger w-100">Delete</button>
          </form>
        </div>
        <% } %>
    </div>
  </div>



  <div id="map" style="height: 400px; border-radius: 12px;"></div>


  <!-- Leave a Review -->
  <% if (currentUser) { %>
    <div class="card shadow-sm rounded-4 p-4 mb-5">
      <h4 class="fw-bold mb-3">Leave a Review</h4>

      <form action="/listing/<%= list.id %>/review" method="POST">
        <!-- Starability rating input -->
        <fieldset class="starability-growRotate mb-3">

          <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked
            aria-label="No rating." />

          <input type="radio" id="rate1" name="review[rating]" value="1" />
          <label for="rate1">1 star</label>

          <input type="radio" id="rate2" name="review[rating]" value="2" />
          <label for="rate2">2 stars</label>

          <input type="radio" id="rate3" name="review[rating]" value="3" />
          <label for="rate3">3 stars</label>

          <input type="radio" id="rate4" name="review[rating]" value="4" />
          <label for="rate4">4 stars</label>

          <input type="radio" id="rate5" name="review[rating]" value="5" />
          <label for="rate5">5 stars</label>

          <span class="starability-focus-ring"></span>
        </fieldset>

        <!-- Comment textarea -->
        <textarea name="review[comment]" class="form-control mb-2" rows="3" placeholder="Write your review..."
          required></textarea>
        <button class="btn btn-primary w-100">Submit</button>
      </form>
    </div>
    <% } %>

      <!-- All Reviews -->
      <h3 class="mb-3 fw-bold text-center">All Reviews</h3>
      <div class="row g-4">
        <% list.reviews.forEach(review=> { %>
          <% if (review && review.author) { %>
            <div class="col-md-4 col-sm-6 col-12">
              <div class="card shadow-sm rounded-4 h-100 p-3">
                <p class="text-muted">@<%= review.author.username %>
                </p>
                <div class="d-flex justify-content-between mb-2">
                  <h6 class="text-secondary fw-bold"><i class="bi bi-person-circle me-1"></i> Reviewer</h6>
                  <span class="badge bg-warning text-dark">⭐ <%= review.rating %>/5</span>
                </div>
                <p class="text-muted">
                  <%= review.comment %>
                </p>

                <% if (currentUser && review.author._id.equals(currentUser._id)) { %>
                  <form action="/listing/<%= list.id %>/review/<%= review._id %>?_method=DELETE" method="POST">
                    <button class="btn btn-outline-danger w-100 btn-sm">Delete</button>
                  </form>
                  <% } %>
              </div>
            </div>
            <% } %>
              <% }) %>
      </div>
<script>
  const coords = <%- JSON.stringify(coordinates) %>; // [lng, lat] from DB
  const map = L.map('map').setView([coords[1], coords[0]], 13); // swap for Leaflet

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
  }).addTo(map);

  L.marker([coords[1], coords[0]]) // swap here too
    .addTo(map)
    .bindPopup(`<b><%= list.title %></b><br><%= list.location %>`)
    .openPopup();
</script>

