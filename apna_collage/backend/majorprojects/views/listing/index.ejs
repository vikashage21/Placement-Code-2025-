<% layout('layouts/boilerplate') -%>
<h1 class="mb-5 text-center fw-bold">All Listings</h1>
<div class="row g-4">
  <% allListing.forEach(e => { %>
  <div class="col-md-4 col-sm-6 col-12">
    <a href="/listing/<%= e.id %>" class="text-decoration-none">
      <div class="card h-100 shadow-sm rounded-4 overflow-hidden hover-shadow">
        <div style="height: 220px; overflow: hidden;">
          <% if (e.image) { %>
          <img src="<%= e.image.url %>" class="card-img-top w-100 h-100" style="object-fit: cover;" alt="<%= e.title %>">
          <% } else { %>
          <img src="https://via.placeholder.com/300x220?text=No+Image" class="card-img-top" alt="No Image">
          <% } %>
        </div>
        <div class="card-body text-center">
          <h5 class="card-title fw-bold text-dark"><%= e.title %></h5>
          <p class="text-secondary">₹<%= Number(e.price).toLocaleString('en-IN') %> / night</p>
        </div>
      </div>
    </a>
  </div>
  <% }) %>
</div>

<style>
.hover-shadow:hover { transform: translateY(-5px); box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15); transition: 0.3s; }
</style>
