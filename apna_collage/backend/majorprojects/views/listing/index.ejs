<% layout('layouts/boilerplate') -%>

    <div class="container my-5">
        <h1 class="mb-4 text-center">All Listings</h1>

        <div class="row">
            <% allListing.forEach(e=> { %>
                <div class="col-md-4 mb-4">
                    <a style="text-decoration: none;" href="/listing/<%=e.id %>">
                        <div class="card h-100">
                            <!-- Image wrapper with fixed height -->
                            <div style="height: 200px; overflow: hidden;">
                                <% if (e.image) { %>
                                    <img src="<%= e.image %>" class="card-img-top w-100 h-100 "
                                        style="object-fit: cover;" alt="<%= e.title %>" loading="lazy">
                                    <% } else { %>
                                        <img src="https://via.placeholder.com/300x200?text=No+Image"
                                            class="card-img-top w-100 h-100" style="object-fit: cover;" alt="No Image"
                                            loading="lazy">
                                        <% } %>
                            </div>

                            <div class="card-body">
                                <h5 class="card-title text-center">
                                    <%= e.title %>
                                </h5>
                                <p class="card-title text-center">
                                    ₹<%= e.price.toLocaleString('en-IN') %> / night
                                </p>

                            </div>
                        </div>
                    </a>
                </div>
                <% }); %>
        </div>

    </div>