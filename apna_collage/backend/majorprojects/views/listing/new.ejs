<% layout('layouts/boilerplate') -%>

    <div class="container my-5">
        <h1 class="mb-4 text-center">Add New Post</h1>

        <form action="/listing" method="post">
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input type="text" id="title" name="title" class="form-control" placeholder="Enter your title" required>
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea id="description" name="description" class="form-control" rows="5"
                    placeholder="Enter your description" required></textarea>
            </div>

            <div class="mb-3">
                <label for="image" class="form-label">Image URL</label>
                <input type="text" id="image" name="image" class="form-control" placeholder="Enter image URL">
            </div>

            <div class="row offset-2">
                <div class="mb-3 col-2">
                    <label for="price" class="form-label">Price</label>
                    <input type="text" id="price" name="price" class="form-control" placeholder="Enter price">
                </div>

                 <div class="mb-3 col-6 ">
                    <label for="location" class="form-label">Location</label>
                    <input type="text" id="location" name="location" class="form-control" placeholder="Enter location">
                </div>

                
            <div class="mb-3 col-2">
                <label for="country" class="form-label">Country</label>
                <input type="text" id="country" name="country" class="form-control" placeholder="Enter country">
            </div>

               
            </div>



            <button type="submit" class="btn btn-primary mx-auto w-full d-flex">Add Post</button>
        </form>
    </div>